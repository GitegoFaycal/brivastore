# ---- API ----
# Secret used to sign JWTs (change in production)
JWT_SECRET=change-me-in-production
# Local dev port for the API
PORT=5000

# Optional persistence for Vercel (serverless memory resets on cold start).
# Create a free Upstash Redis database and paste the REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" to wipe persisted data and reseed demo data on next boot
RESEED=false
